# CAISO OASIS API base URL (public, no auth required)
CAISO_OASIS_URL=http://oasis.caiso.com/oasisapi/SingleZip

# Default pricing node — SP15 is Southern California aggregation point
CAISO_DEFAULT_NODE=SP15_GEN-APND

# Request timeout in seconds
CAISO_TIMEOUT_SEC=30

# Local cache directory for API responses (avoids repeat network calls)
CACHE_DIR=.cache
